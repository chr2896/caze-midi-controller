{
  "name": "midi-controller-editor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src index.html *.json",
    "format:check": "prettier --check src index.html *.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
